{
  "name": "holo-panels-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Official resource-driven panel system for Holo-JS",
  "license": "MIT",
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@eslint/js": "^9.17.0",
      "@holo-js/adapter-next": "^0.3.10",
      "@holo-js/adapter-nuxt": "^0.3.10",
      "@holo-js/adapter-sveltekit": "^0.3.10",
      "@holo-js/auth": "^0.3.10",
      "@holo-js/auth-social-google": "^0.3.10",
      "@holo-js/authorization": "^0.3.10",
      "@holo-js/broadcast": "^0.3.10",
      "@holo-js/config": "^0.3.10",
      "@holo-js/core": "^0.3.10",
      "@holo-js/cli": "^0.3.10",
      "@holo-js/db": "^0.3.10",
      "@holo-js/db-mysql": "^0.3.10",
      "@holo-js/db-postgres": "^0.3.10",
      "@holo-js/db-sqlite": "^0.3.10",
      "@holo-js/events": "^0.3.10",
      "@holo-js/flux": "^0.3.10",
      "@holo-js/forms": "^0.3.10",
      "@holo-js/kernel": "^0.3.10",
      "@holo-js/mail": "^0.3.10",
      "@holo-js/media": "^0.3.10",
      "@holo-js/notifications": "^0.3.10",
      "@holo-js/queue": "^0.3.10",
      "@holo-js/queue-db": "^0.3.10",
      "@holo-js/realtime": "^0.3.10",
      "@holo-js/security": "^0.3.10",
      "@holo-js/session": "^0.3.10",
      "@holo-js/storage": "^0.3.10",
      "@holo-js/validation": "^0.3.10",
      "@playwright/test": "^1.62.0",
      "@sveltejs/adapter-node": "^5.5.4",
      "@sveltejs/kit": "^2.59.1",
      "@sveltejs/vite-plugin-svelte": "^7.1.0",
      "@types/node": "^22.10.2",
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "@vitest/coverage-v8": "^4.1.10",
      "eslint": "^9.17.0",
      "esbuild": "^0.28.1",
      "fast-check": "^4.3.0",
      "globals": "^15.14.0",
      "happy-dom": "^20.0.10",
      "inflection": "^3.0.2",
      "ioredis": "^5.4.2",
      "h3": "^1.15.11",
      "next": "^16.2.4",
      "nuxt": "^4.4.4",
      "react": "^19.2.6",
      "react-dom": "^19.2.6",
      "svelte": "^5.55.5",
      "svelte-check": "^4.4.6",
      "tsup": "^8.3.5",
      "typescript": "^5.7.2",
      "typescript-eslint": "^8.30.1",
      "ulid": "^3.0.1",
      "uuid": "^12.0.0",
      "vitest": "^4.1.5",
      "vite": "^8.0.10",
      "vue": "^3.5.13",
      "vue-tsc": "^2.2.0"
    }
  },
  "scripts": {
    "build": "node scripts/build-workspace-packages.mjs",
    "typecheck": "bun run build && bun run typecheck:packages",
    "typecheck:packages": "bun run --filter '@holo-js/panels*' --sequential typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "link:holo": "node scripts/link-local-holo.mjs",
    "test": "bun run test:architecture && bun run test:example-parity && bun run --filter '@holo-js/panels*' --sequential test",
    "test:coverage": "node scripts/run-coverage.mjs",
    "test:e2e": "bun run test:e2e:build && playwright test",
    "test:e2e:build": "node tests/e2e/build-examples.mjs",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:typecheck": "tsc -p tests/e2e/tsconfig.json --noEmit",
    "test:architecture": "node --test scripts/build-compatible-holo.test.mjs scripts/link-local-holo.test.mjs scripts/published-manifest-policy.test.mjs scripts/registry-release-policy.test.mjs scripts/release-auth.test.mjs scripts/resolved-release-manifests.test.mjs && node scripts/validate-architecture.mjs && node scripts/validate-dependency-policy.mjs && node scripts/validate-ci-bootstrap.mjs && node scripts/validate-published-packages.mjs",
    "test:conditions": "node scripts/validate-conditional-exports.mjs",
    "test:example-parity": "node scripts/validate-example-parity.mjs",
    "test:p0c": "node scripts/p0c-packed-acceptance.mjs",
    "test:registry-release": "node scripts/p0c-packed-acceptance.mjs --registry",
    "validate": "bun run typecheck && bun run lint && bun run test && bun run test:conditions && bun run test:p0c && node scripts/validate-published-packages.mjs --require-build --pack",
    "examples:generate": "node scripts/generate-example-fixtures.mjs",
    "version-packages": "node scripts/version-packages.mjs",
    "release": "node scripts/release.mjs --publish"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "^1.62.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "catalog:",
    "globals": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "cookie": "0.7.2",
    "esbuild": "0.28.1",
    "minimatch": "10.2.6",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "packageManager": "bun@1.3.9",
  "dependencies": {
    "@holo-js/authorization": "^0.3.10",
    "@holo-js/cache": "^0.3.10",
    "@holo-js/core": "^0.3.10",
    "@holo-js/db-sqlite": "^0.3.10",
    "@holo-js/kernel": "^0.3.10"
  }
}
