{
  "name": "@holo-js/panels-core",
  "version": "0.1.0-next.0",
  "description": "Framework-neutral Holo Panels definitions and server contracts",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "import": "./dist/browser.mjs",
        "default": "./dist/browser.mjs"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "default": "./dist/server.mjs"
    },
    "./transfers": {
      "types": "./dist/transfers.d.ts",
      "import": "./dist/transfers.mjs",
      "default": "./dist/transfers.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run --passWithNoTests --reporter=json"
  },
  "peerDependencies": {
    "@holo-js/auth": "catalog:",
    "@holo-js/authorization": "catalog:",
    "@holo-js/broadcast": "catalog:",
    "@holo-js/config": "catalog:",
    "@holo-js/core": "catalog:",
    "@holo-js/db": "catalog:",
    "@holo-js/flux": "catalog:",
    "@holo-js/forms": "catalog:",
    "@holo-js/media": "catalog:",
    "@holo-js/notifications": "catalog:",
    "@holo-js/queue": "catalog:",
    "@holo-js/realtime": "catalog:",
    "@holo-js/security": "catalog:",
    "@holo-js/storage": "catalog:",
    "@holo-js/validation": "catalog:"
  },
  "peerDependenciesMeta": {
    "@holo-js/broadcast": {
      "optional": true
    },
    "@holo-js/flux": {
      "optional": true
    },
    "@holo-js/media": {
      "optional": true
    },
    "@holo-js/notifications": {
      "optional": true
    },
    "@holo-js/queue": {
      "optional": true
    },
    "@holo-js/realtime": {
      "optional": true
    },
    "@holo-js/storage": {
      "optional": true
    }
  },
  "devDependencies": {
    "fast-check": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
