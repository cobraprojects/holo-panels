{
  "name": "@holo-js/panels-react",
  "version": "0.1.0-next.1",
  "description": "React renderer for Holo Panels",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "react-server": {
        "types": "./dist/server.d.ts",
        "import": "./dist/server.mjs",
        "default": "./dist/server.mjs"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "default": "./dist/server.mjs"
    },
    "./style.css": "./dist/style.css"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run --passWithNoTests --reporter=json"
  },
  "dependencies": {
    "@holo-js/panels-client": "workspace:*",
    "@holo-js/panels-core": "workspace:*",
    "@holo-js/panels-ui": "workspace:*",
    "@radix-ui/react-slot": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "catalog:",
    "lucide-react": "catalog:",
    "radix-ui": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "happy-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
