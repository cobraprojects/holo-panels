{
  "name": "@holo-js/panels-sveltekit",
  "version": "0.1.0-next.0",
  "description": "SvelteKit adapter for Holo Panels",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "default": "./dist/server.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/package-svelte-source.mjs",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest --run --passWithNoTests --reporter=json"
  },
  "dependencies": {
    "@holo-js/panels-svelte": "workspace:*"
  },
  "peerDependencies": {
    "@holo-js/adapter-sveltekit": "catalog:",
    "@holo-js/security": "catalog:",
    "@sveltejs/kit": "catalog:",
    "svelte": "catalog:"
  },
  "devDependencies": {
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
