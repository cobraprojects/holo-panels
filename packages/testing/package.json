{
  "name": "@holo-js/panels-testing",
  "version": "0.1.0-next.0",
  "description": "Behavior and renderer contract testing utilities for Holo Panels",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "default": "./dist/react.mjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.mjs",
      "default": "./dist/vue.mjs"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.mjs",
      "default": "./dist/svelte.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run --passWithNoTests --reporter=json"
  },
  "dependencies": {
    "@holo-js/panels-core": "workspace:*",
    "@holo-js/panels-client": "workspace:*",
    "@holo-js/panels-ui": "workspace:*"
  },
  "peerDependencies": {
    "@holo-js/panels-react": "workspace:*",
    "@holo-js/panels-svelte": "workspace:*",
    "@holo-js/panels-vue": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "svelte": "catalog:",
    "vue": "catalog:"
  },
  "peerDependenciesMeta": {
    "@holo-js/panels-react": {
      "optional": true
    },
    "@holo-js/panels-svelte": {
      "optional": true
    },
    "@holo-js/panels-vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@holo-js/db": "catalog:",
    "@holo-js/notifications": "catalog:",
    "@holo-js/queue": "catalog:",
    "@holo-js/storage": "catalog:",
    "@holo-js/panels-react": "workspace:*",
    "@holo-js/panels-shield": "workspace:*",
    "@holo-js/panels-svelte": "workspace:*",
    "@holo-js/panels-vue": "workspace:*",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "svelte": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
}
