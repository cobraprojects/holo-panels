{
  "name": "@holo-js/panels-vue",
  "version": "0.1.0-next.1",
  "description": "Vue renderer for Holo Panels",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "default": "./dist/server.mjs"
    },
    "./style.css": "./dist/style.css"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsup",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest --run --passWithNoTests --reporter=json"
  },
  "dependencies": {
    "@holo-js/panels-client": "workspace:*",
    "@holo-js/panels-core": "workspace:*",
    "@holo-js/panels-ui": "workspace:*",
    "@radix-icons/vue": "catalog:",
    "@vueuse/core": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-vue-next": "catalog:",
    "reka-ui": "catalog:",
    "tailwind-merge": "catalog:",
    "vue-sonner": "catalog:"
  },
  "peerDependencies": {
    "vue": "catalog:"
  },
  "devDependencies": {
    "happy-dom": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "vue": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
